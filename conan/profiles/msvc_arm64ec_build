#
# Build profile for the Windows on ARM (ARM64EC) jobs.
#
# The build tools are plain x64 binaries.
#
# compiler.march is deliberately not set here, as in the ARM64EC host
# profiles.
include(_msvc)
include(_qt_windows)

[settings]
arch=x86_64
build_type=Release
compiler.runtime_type=Release
