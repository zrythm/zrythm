@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://lv2plug.in/plugins/eg-amp>
	a lv2:Plugin ;
	lv2:binary <amp@CMAKE_SHARED_LIBRARY_SUFFIX@>  ;
	rdfs:seeAlso <amp.ttl> .

<http://lv2plug.in/plugins/eg-amp-float-window>
	a lv2:Plugin ;
	lv2:binary <amp@CMAKE_SHARED_LIBRARY_SUFFIX@> ;
	rdfs:seeAlso <amp-float-window.ttl> .

<http://lv2plug.in/plugins/eg-amp#ui>
	a ui:X11UI ;
	ui:binary <amp-ui@CMAKE_SHARED_LIBRARY_SUFFIX@> ;
	rdfs:seeAlso <amp-ui.ttl> .

<http://lv2plug.in/plugins/eg-amp#preset_boost>
	a pset:Preset ;
	lv2:appliesTo <http://lv2plug.in/plugins/eg-amp> ;
	rdfs:seeAlso <presets.ttl> .

<http://lv2plug.in/plugins/eg-amp#preset_half>
	a pset:Preset ;
	lv2:appliesTo <http://lv2plug.in/plugins/eg-amp> ;
	rdfs:seeAlso <presets.ttl> .

<http://lv2plug.in/plugins/eg-amp#preset_muted>
	a pset:Preset ;
	lv2:appliesTo <http://lv2plug.in/plugins/eg-amp> ;
	rdfs:seeAlso <presets.ttl> .
